# pixi environment (re-created by `pixi install`)
.pixi/

# indexio search index + build jobs (rebuilt by `projio sync`)
.projio/indexio/index/
.projio/indexio/jobs/

# snakemake run state
.snakemake/

# generated by `projio sync` (regenerated on every machine)
.projio/filters/
.projio/render/csl/
.projio/render/pandoc-defaults.yaml
.projio/render/compiled.bib
.projio/render/quarto.yml
.projio/projio.mk
.projio/servers.json
.claude/commands/

# pipeline outputs (regenerated from data/raw by the demo rule)
data/derivatives/

# quarto render artifacts
docs/deliverables/*_files/
docs/deliverables/.quarto/
/_freeze/

# python / notebook noise
__pycache__/
*.pyc
.ipynb_checkpoints/

# NOTE: .mcp.json and .claude/settings.json are intentionally tracked —
# they are the pre-configured tool surface this starter ships.
